# moat configuration.
# `./moat init` generates `.env` from this file. Edit that copy, not this one.

# --- Versions (pinned; bump deliberately) ---
STACK_VERSION=9.5.4
CADDY_VERSION=2.10

# --- Profile: standard | lite ---
PROFILE=standard

# --- Host identity ---
# LAN IP that endpoints use to reach this box (Fleet + Elasticsearch).
HOST_IP=
# DNS name for the box (added to cert SANs). Optional.
HOST_NAME=moat.local
# Interface address to bind published ports to. Use HOST_IP to keep it off other NICs.
BIND_IP=

# --- Published ports ---
KIBANA_PORT=443
ES_PORT=9200
FLEET_PORT=8220

# --- Memory (set by profile in init; override here) ---
ES_HEAP=4g
ES_MEM_LIMIT=6g
KIBANA_MEM_LIMIT=1536m
FLEET_MEM_LIMIT=768m

# --- Retention (days) ---
RETENTION_NETWORK_DAYS=7
RETENTION_ENDPOINT_DAYS=30

# --- Detections ---
# Prebuilt rules are all installed; these tags (| separated) are enabled at bootstrap.
ENABLE_RULE_TAGS="Data Source: Elastic Defend"

# --- Network sensor (Phase 2) ---
# Interface receiving mirrored traffic. Leave blank for --no-sensor mode.
SENSOR_IFACE=

# --- Secrets (generated by init; never commit .env) ---
ELASTIC_PASSWORD=
KIBANA_SYSTEM_PASSWORD=
ANALYST_PASSWORD=
KIBANA_ENCRYPTION_KEY=
KIBANA_SECURITY_KEY=
KIBANA_REPORTING_KEY=
