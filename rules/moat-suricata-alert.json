{
  "rule_id": "moat-suricata-alert",
  "name": "moat: Suricata alert (high/medium)",
  "description": "Promotes Suricata alerts of severity 1 (high) and 2 (medium) into Security alerts. Severity 3 (informational, e.g. ET INFO) stays searchable in Discover for hunting but does not alert.",
  "type": "query",
  "language": "kuery",
  "index": ["logs-suricata.eve-*"],
  "query": "event.kind:\"alert\" and event.severity <= 2",
  "severity": "medium",
  "severity_mapping": [
    {"field": "event.severity", "operator": "equals", "value": "1", "severity": "high"},
    {"field": "event.severity", "operator": "equals", "value": "2", "severity": "medium"}
  ],
  "risk_score": 47,
  "rule_name_override": "rule.name",
  "interval": "5m",
  "from": "now-10m",
  "max_signals": 200,
  "tags": ["moat", "Data Source: Suricata", "Domain: Network"],
  "enabled": true
}
