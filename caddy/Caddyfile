{
	auto_https off
	admin off
}

:443 {
	tls /certs/kibana/kibana.crt /certs/kibana/kibana.key

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# Public CA cert + fingerprint for agent enrollment (no secrets live here).
	handle /moat-ca.crt {
		root * /certs/public
		rewrite * /ca.crt
		file_server
	}
	handle /moat-ca.sha256 {
		root * /certs/public
		rewrite * /ca.sha256
		file_server
	}

	handle {
		reverse_proxy https://kibana:5601 {
			transport http {
				tls_trust_pool file /certs/public/ca.crt
				tls_server_name kibana
			}
		}
	}
}

# DFIR-IRIS case management (compose profile "iris"). Same moat certificate; the
# kibana cert's SANs cover HOST_IP. Caddy sets X-Forwarded-Proto, which IRIS trusts
# (ProxyFix, one hop) for its secure session cookies. WebSockets pass through.
:8443 {
	tls /certs/kibana/kibana.crt /certs/kibana/kibana.key

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}

	reverse_proxy iris-app:8000
}
